{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-3d-factory.local/schemas/build_plan.schema.json",
  "title": "Build Plan",
  "description": "Deterministic local planning stub produced by factory plan from a project_brief.",
  "type": "object",
  "required": [
    "status",
    "tool_routing_recommendation",
    "required_parts",
    "validation_gates",
    "human_review_required"
  ],
  "properties": {
    "status": {
      "type": "string",
      "const": "plan_drafted"
    },
    "tool_routing_recommendation": {
      "type": "object",
      "required": ["primary_tool", "rationale"],
      "properties": {
        "primary_tool": {
          "type": "string",
          "enum": ["openscad", "cadquery", "blender", "meshy", "unspecified"]
        },
        "rationale": { "type": "string" }
      }
    },
    "required_parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["part_name", "role"],
        "properties": {
          "part_name": { "type": "string" },
          "role": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "validation_gates": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "geometry_sanity_check",
          "dimension_fit_check",
          "multipart_alignment_check",
          "preview_render",
          "slicer_review_package",
          "human_approval"
        ]
      },
      "minItems": 1
    },
    "human_review_required": {
      "type": "boolean",
      "const": true
    }
  },
  "additionalProperties": true
}
