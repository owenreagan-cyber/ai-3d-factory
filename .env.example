# .env.example for ai-3d-factory
#
# This is a TEMPLATE with placeholder variable names only. It contains no
# real values. Do not create a real `.env` with live secrets; this project
# does not call paid or cloud APIs in Phase 0/1, and none of these
# variables are read by the current CLI.
#
# All of the following are optional and future, and are NOT used by the
# current `factory` CLI.

# Optional/future - Meshy generative-mesh API. NOT approved for use yet.
# MESHY_API_KEY=

# Optional/future - OpenAI API. NOT approved for use yet.
# OPENAI_API_KEY=

# Optional/future - Google Gemini API. NOT approved for use yet.
# GEMINI_API_KEY=

# Optional/future - Anthropic API, distinct from the Claude Code CLI login.
# NOT approved for use yet.
# ANTHROPIC_API_KEY=
